# Configuración para conectar a AWS desde local
# IMPORTANTE: Reemplaza estos valores con los reales antes de usar

# IPs públicas de tus EC2s
DB_HOST=YOUR_POSTGRES_EC2_PUBLIC_IP    # Ejemplo: 18.222.130.207
REDIS_HOST=YOUR_REDIS_EC2_PUBLIC_IP    # Ejemplo: 18.119.97.12

# Configuración de base de datos
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_THIS_PASSWORD       # Cambia por tu contraseña real
DB_NAME=topicos_db

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=                        # Si tienes contraseña para Redis

# JWT
JWT_SECRET=CHANGE_THIS_JWT_SECRET      # Cambia por tu JWT secret real

# Otras configuraciones
NODE_ENV=development
PORT=3000

# INSTRUCCIONES:
# 1. Copia este archivo como .env.aws
# 2. Reemplaza los valores YOUR_* con las IPs reales de tus EC2s
# 3. Cambia las contraseñas por las reales
# 4. Asegúrate de que los Security Groups permitan conexiones desde tu IP
