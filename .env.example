# =================================================================
# 📋 SISTEMA DE COLAS UNIVERSAL - CONFIGURACIÓN COMPLETA
# =================================================================
# Basado en FASE-2-SISTEMA-COLAS-UNIVERSAL.md
# Fecha: 31 de agosto de 2025

# =================================================================
# DATABASE CONFIGURATION
# =================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=uagrm_inscripciones

# Database Pool Configuration (Fase 5.1 - Connection Pooling)
WORKER_DB_POOL_MAX=5
WORKER_DB_POOL_MIN=1
DB_ACQUIRE_TIMEOUT=10000
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# =================================================================
# REDIS CONFIGURATION
# =================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis Connection Settings (Fase 1.1)
REDIS_CONNECT_TIMEOUT=5000
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100
REDIS_MAX_LOADING_TIMEOUT=5000

# =================================================================
# APPLICATION CONFIGURATION
# =================================================================
NODE_ENV=development
PORT=3000

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_secure

# =================================================================
# QUEUE SYSTEM CONFIGURATION (Fase 1.2 - BullMQ Integration)
# =================================================================

# Queue Timeouts (en segundos)
QUEUE_CRITICAL_TIMEOUT=30
QUEUE_STANDARD_TIMEOUT=60
QUEUE_BACKGROUND_TIMEOUT=120

# Queue Job Options
QUEUE_CRITICAL_ATTEMPTS=3
QUEUE_STANDARD_ATTEMPTS=2
QUEUE_BACKGROUND_ATTEMPTS=1

# Queue Job TTL (en milisegundos) - 1 hora por defecto
QUEUE_JOB_TTL=3600000

# Queue Cleanup Settings
QUEUE_REMOVE_ON_COMPLETE=100
QUEUE_REMOVE_ON_FAIL=50

# Queue Delays (en milisegundos)
QUEUE_CRITICAL_DELAY=0
QUEUE_STANDARD_DELAY=100
QUEUE_BACKGROUND_DELAY=1000

# =================================================================
# WORKER CONFIGURATION (Fase 5.1 - Resource Management)
# =================================================================

# Memory Limits (en MB)
WORKER_MAX_HEAP_MB=256
WORKER_MAX_RSS_MB=512
WORKER_MAX_CPU_PERCENT=80

# Worker Processing Settings
WORKER_CONCURRENCY=1
WORKER_ID=main

# Garbage Collection Settings
WORKER_GC_INTERVAL=30000
WORKER_HEAVY_JOB_THRESHOLD=10000

# =================================================================
# MONITORING CONFIGURATION (Fase 5.1)
# =================================================================

# Resource Monitoring Intervals (en milisegundos)
MONITORING_RESOURCE_INTERVAL=5000
MONITORING_CONNECTION_POOL_INTERVAL=10000
MONITORING_HEALTH_CHECK_INTERVAL=30000

# Monitoring History Limits
MONITORING_MAX_STATS_HISTORY=100
MONITORING_MAX_POOL_HISTORY=50

# =================================================================
# CACHE CONFIGURATION (Fase 4.1 - Cache Simple)
# =================================================================

# Cache Settings
CACHE_MAX_ENTRIES=1000
CACHE_TTL_MINUTES=5
CACHE_ENABLED=true

# Cache Cleanup
CACHE_CLEANUP_INTERVAL=60000

# =================================================================
# POLLING CONFIGURATION (Fase 2.2 - Cliente Polling)
# =================================================================

# Client Polling Settings (en milisegundos)
POLLING_INTERVAL=2000
POLLING_MAX_TIME=120000
POLLING_TIMEOUT_RETRIES=3

# =================================================================
# LOAD TESTING CONFIGURATION (Fase 5.3)
# =================================================================

# Load Test Settings
LOAD_TEST_MAX_WAIT_TIME=300000
LOAD_TEST_CHECK_INTERVAL=2000
LOAD_TEST_PAUSE_MS=100
LOAD_TEST_HEAVY_PAUSE_MS=50

# =================================================================
# TRANSACTION CONFIGURATION
# =================================================================

# Transaction Timeouts and Retries
TRANSACTION_TIMEOUT=5000
TRANSACTION_MAX_RETRIES=3
TRANSACTION_RETRY_DELAY=100
TRANSACTION_MAX_DELAY=1000

# =================================================================
# IDEMPOTENCY CONFIGURATION
# =================================================================

# Idempotency Settings (en milisegundos)
IDEMPOTENCY_TTL=3600000
IDEMPOTENCY_PROCESSING_TTL=900000

# =================================================================
# DEBUG Y DESARROLLO
# =================================================================

# Logging Levels
LOG_LEVEL=info
LOG_QUEUE_OPERATIONS=false
LOG_WORKER_STATS=false
LOG_RESOURCE_USAGE=false

# Development Settings
ENABLE_QUEUE_SYSTEM=true
ENABLE_CACHE=true
ENABLE_MONITORING=true