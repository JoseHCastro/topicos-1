# Configuración para producción en AWS EC2
# IMPORTANTE: Reemplaza estos valores antes de desplegar

# IPs privadas de tus EC2s (obtenidas con hostname -I)
DB_HOST=REPLACE_WITH_POSTGRES_PRIVATE_IP    # Ejemplo: 172.31.30.231
REDIS_HOST=REPLACE_WITH_REDIS_PRIVATE_IP    # Ejemplo: 172.31.25.251

# Configuración de base de datos
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION
DB_NAME=topicos_db

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT - CAMBIAR EN PRODUCCIÓN
JWT_SECRET=CHANGE_THIS_JWT_SECRET_IN_PRODUCTION

# Configuración de aplicación
NODE_ENV=production
PORT=3000

# URLs para CORS
FRONTEND_URL=http://your-frontend-domain.com

# INSTRUCCIONES:
# 1. Copia este archivo como .env.production
# 2. Reemplaza REPLACE_WITH_* con las IPs privadas reales de tus EC2s
# 3. CAMBIA todas las contraseñas por valores seguros
# 4. Genera un JWT secret fuerte para producción
